      "difficulty": "easy",
      "emoji": "🍲",
      "description": "A sour and savory tamarind soup loaded with tender pork and vegetables. Comforting, bright, and perfect on a rainy day.",
      "prepMinutes": 20,
      "cookMinutes": 60,
      "servings": 6,
      "tags": [
        "soup",
        "sour",
        "comfort food",
        "tamarind"
      ],
      "ingredients": [
        {
          "name": "Pork belly or ribs",
          "quantity": "1 kg",
          "note": "cut into chunks"
        },
        {
          "name": "Tamarind soup base",
          "quantity": "1 packet",
          "note": "or 200 g fresh tamarind"
        },
        {
          "name": "Water",
          "quantity": "2 liters"
        },
        {
          "name": "Tomatoes",
          "quantity": "2",
          "note": "quartered"
        },
        {
          "name": "Onion",
          "quantity": "1",
          "note": "quartered"
        },
        {
          "name": "Radish (labanos)",
          "quantity": "1",
          "note": "sliced"
        },
        {
          "name": "String beans",
          "quantity": "1 bunch",
          "note": "cut into 2-inch pieces"
        },
        {
          "name": "Eggplant",
          "quantity": "1",
          "note": "sliced"
        },
        {
          "name": "Kangkong (water spinach)",
          "quantity": "1 bunch"
        },
        {
          "name": "Long green chili",
          "quantity": "2"
        },
        {
          "name": "Fish sauce",
          "quantity": "2 tbsp"
        }
      ],
      "steps": [
        "Place pork, water, onion, and tomatoes in a large pot. Bring to a boil, skimming off any scum.",
        "Reduce heat and simmer for 45 minutes until the pork is tender.",
        "Add radish and cook for 5 minutes, then add string beans and eggplant and cook 5 minutes more.",
        "Stir in the tamarind base and fish sauce. Taste and adjust sourness and salt.",
        "Add the chili and kangkong, cook for 1 minute, then turn off the heat.",
        "Serve steaming hot with rice and extra fish sauce on the side."
      ]
    },
    {
      "id": "kare-kare",
      "name": "Kare-Kare",
      "localName": "Kare-Kare",
      "cuisine": "filipino",
      "category": "main",
      "difficulty": "hard",
      "emoji": "🥜",
      "description": "A rich oxtail stew in a velvety peanut sauce, served with sauteed shrimp paste. A celebration dish that rewards patience.",
      "prepMinutes": 30,
      "cookMinutes": 180,
      "servings": 6,
      "tags": [
        "stew",
        "peanut",
        "oxtail",
        "fiesta"
      ],
      "ingredients": [
        {
          "name": "Oxtail",
          "quantity": "1.5 kg",
          "note": "cut into 2-inch pieces"
        },
        {
          "name": "Water",
          "quantity": "3 liters"
        },
        {
          "name": "Peanut butter",
          "quantity": "1 cup",
          "note": "unsweetened"
        },
        {
          "name": "Toasted ground rice",
          "quantity": "1/4 cup"
        },
        {
          "name": "Annatto (atsuete) powder",
          "quantity": "1 tbsp"
        },
        {
          "name": "Onion",
          "quantity": "1",
          "note": "chopped"
        },
        {
          "name": "Garlic",
          "quantity": "6 cloves",
          "note": "minced"
        },
        {
          "name": "Banana blossom",
          "quantity": "1",
          "note": "sliced"
        },
        {
          "name": "Eggplant",
          "quantity": "2",
          "note": "sliced"
        },
        {
          "name": "String beans",
          "quantity": "1 bunch"
        },
        {
          "name": "Bok choy (pechay)",
          "quantity": "1 bunch"
        },
        {
          "name": "Bagoong (shrimp paste)",
          "quantity": "1/2 cup",
          "note": "for serving"
        }
      ],
      "steps": [
        "Simmer the oxtail in water for 2.5 to 3 hours until fork-tender. Reserve 4 cups of the broth.",
        "In a separate pot, saute garlic and onion in oil. Add annatto powder and stir until the oil turns orange.",
        "Pour in the reserved broth. Whisk in peanut butter and toasted ground rice until smooth.",
        "Add the oxtail and simmer for 15 minutes until the sauce thickens.",
        "Add banana blossom and eggplant, cook 5 minutes, then add string beans and bok choy for 3 minutes.",
        "Serve with sauteed bagoong on the side and plenty of rice."
      ]
    },
    {
      "id": "lechon-kawali",
      "name": "Lechon Kawali",
      "localName": "Lechon Kawali",
      "cuisine": "filipino",
      "category": "main",
      "difficulty": "medium",
      "emoji": "🥓",
      "description": "Crispy deep-fried pork belly with crackling skin and juicy meat. Served with a tangy liver sauce or spiced vinegar.",
      "prepMinutes": 15,
      "cookMinutes": 90,
      "servings": 6,
      "tags": [
        "crispy",
        "pork",
        "fried",
        "party"
      ],
      "ingredients": [
        {
          "name": "Pork belly",
          "quantity": "1.5 kg",
          "note": "whole slab"
        },
        {
          "name": "Water",
          "quantity": "2 liters"
        },
        {
          "name": "Garlic",
          "quantity": "1 head",
          "note": "smashed"
        },
        {
          "name": "Bay leaves",
          "quantity": "3"
        },
        {
          "name": "Whole peppercorns",
          "quantity": "1 tbsp"
        },
        {
          "name": "Salt",
          "quantity": "2 tbsp"
        },
        {
          "name": "Cooking oil",
          "quantity": "4 cups",
          "note": "for deep frying"
        }
      ],
      "steps": [
        "Place pork belly, water, garlic, bay leaves, peppercorns, and salt in a pot. Boil then simmer for 45 minutes.",
        "Remove the pork and pat completely dry. Refrigerate uncovered for at least 1 hour so the skin dries out.",
        "Heat oil to 180°C in a deep pot. Carefully lower in the pork, skin-side down. Cover loosely as it will spatter.",
        "Fry for 15 to 20 minutes until the skin is blistered and golden, turning once.",
        "Rest for 10 minutes, then chop into bite-size pieces.",
        "Serve with spiced vinegar or lechon sauce."
      ]
    },
