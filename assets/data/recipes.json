    {
      "id": "chicken-adobo",
      "name": "Chicken Adobo",
      "localName": "Adobong Manok",
      "cuisine": "filipino",
      "category": "main",
      "difficulty": "easy",
      "emoji": "🍗",
      "description": "The unofficial national dish of the Philippines. Chicken braised in soy sauce, vinegar, garlic, and black pepper until the sauce turns glossy and deeply savory.",
      "prepMinutes": 15,
      "cookMinutes": 45,
      "servings": 4,
      "tags": [
        "classic",
        "braised",
        "one-pot",
        "family favorite"
      ],
      "ingredients": [
        {
          "name": "Chicken thighs",
          "quantity": "1 kg",
          "note": "bone-in, skin-on"
        },
        {
          "name": "Soy sauce",
          "quantity": "1/2 cup"
        },
        {
          "name": "Cane vinegar",
          "quantity": "1/2 cup",
          "note": "or white vinegar"
        },
        {
          "name": "Garlic",
          "quantity": "1 head",
          "note": "smashed"
        },
        {
          "name": "Bay leaves",
          "quantity": "3"
        },
        {
          "name": "Whole black peppercorns",
          "quantity": "1 tsp"
        },
        {
          "name": "Brown sugar",
          "quantity": "1 tbsp"
        },
        {
          "name": "Water",
          "quantity": "1/2 cup"
        },
        {
          "name": "Cooking oil",
          "quantity": "2 tbsp"
        }
      ],
      "steps": [
        "Combine chicken, soy sauce, vinegar, garlic, bay leaves, and peppercorns in a bowl. Marinate for at least 30 minutes.",
        "Heat oil in a heavy pot. Remove chicken from marinade and sear skin-side down until golden, about 4 minutes per side.",
        "Pour in the marinade and water. Bring to a boil without stirring, then reduce to a simmer.",
        "Cover and simmer for 30 minutes, turning the chicken once.",
        "Uncover, add brown sugar, and simmer until the sauce reduces and coats the chicken, about 10 minutes.",
        "Serve hot over steamed rice."
      ]
    },
    {
      "id": "pork-sinigang",
